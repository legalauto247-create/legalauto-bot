# 🤖 LegalAuto Bot — Environment Variables Template
# НИКОГДА не коммитить реальные токены в Git!
# Сделайте копию этого файла в .env и заполните реальные значения

# Telegram Bot
EDO_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Anthropic (Claude) API
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# GitHub API (для скрипта push_jarvis.py)
GITHUB_TOKEN=ghp_your-personal-access-token-here

# Railway Environment
NODE_ENV=production
PORT=3000

# Logging
LOG_LEVEL=info
